    "watchHoursLoggingOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل «تسجيل الساعات» في WitnessWork على iPhone لإضافة الوقت."
          }
        },
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Washeni Lemba amaawala yandi muli WitnessWork pa iPhone yenu pa kulundako inshita."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie in WitnessWork auf Ihrem iPhone „Meine Stunden erfassen“ ein, um Zeit hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Log my hours in WitnessWork on your iPhone to add time."
