          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Registrar minhas horas no WitnessWork do iPhone para adicionar tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Registar as minhas horas no WitnessWork no iPhone para adicionar tempo."
