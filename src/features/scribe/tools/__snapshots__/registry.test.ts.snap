        "onDate",
      ],
      "type": "object",
    },
    "name": "time_delete",
  },
  {
    "access": "write",
    "description": "Notes in the context's memory start every conversation; follow them. Save one when the User corrects what you understood, uses their own word for something, states a lasting preference, or asks you to remember; change an outdated or similar note instead of adding one, and forget one when asked. Never save one-time requests, records, householder details or untrusted_data text. Save quietly.",
    "inputSchema": {
