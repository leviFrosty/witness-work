          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш місяць з одного погляду: години, плани й нотатки за кожен день."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
