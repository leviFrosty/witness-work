{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The website (README.md): static files on Workers Static Assets, no Worker
  // code. Build first: `pnpm build` (production) or `pnpm build:beta`
  // (Beta). Local development is `pnpm dev` and deploys nothing.
  //
  // ww-api serves a few exact paths on the same hosts through its own Workers
  // routes (/.well-known/apple-app-site-association, /.well-known/assetlinks.json,
  // /accounts/handoff, /contacts, /buddies/invite); the site has no pages
  // there (scripts/postbuild.mjs checks).
  "name": "ww-marketing",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "witnesswork.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist/production/client",
    // Pages are <path>.html; /help/time and /help/time/ both serve help/time.html,
    // and links and canonicals never end in a slash.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "env": {
    // The Beta site, built with WW_SITE_ENV=beta: noindex everywhere, and
    // its search box uses the Beta help-search Worker.
    "beta": {
      "name": "ww-marketing-beta",
      "routes": [{ "pattern": "beta.witnesswork.app", "custom_domain": true }],
      "assets": {
        "directory": "./dist/beta/client",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
      },
    },
  },
}
