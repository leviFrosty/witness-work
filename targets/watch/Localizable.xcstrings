    "siriTimerTooLong" : {
      "extractionState" : "manual",
      "localizations" : {
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icakupimako cikwata amaawala 24 nelyo ukucilapo, ico cacila pa cintu cimo. Moneni inshita muli WitnessWork."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Timer hat 24 Stunden oder mehr, was für einen Eintrag zu lang ist. Prüfen Sie die Zeit in WitnessWork."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timer has 24 hours or more, which is too long for one entry. Check the time in WitnessWork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cronómetro tiene 24 horas o más, lo cual es demasiado para una sola entrada. Comprueba el tiempo en WitnessWork."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minuteur affiche 24 heures ou plus, ce qui est trop long pour une seule entrée. Vérifiez le temps dans WitnessWork."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer ha 24 ore o più, troppo per una sola voce. Controlla il tempo in WitnessWork."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーが24時間以上になっており、1件の記録としては長すぎます。WitnessWorkで時間を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 24시간 이상이어서 하나의 기록으로는 너무 깁니다. WitnessWork에서 시간을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De timer staat op 24 uur of meer, wat te lang is voor één registratie. Controleer de tijd in WitnessWork."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cronômetro tem 24 horas ou mais, o que é longo demais para um registro. Confira o tempo no WitnessWork."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O temporizador tem 24 horas ou mais, o que é demasiado para um só registo. Verifique o tempo no WitnessWork."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В таймере 24 часа или больше — слишком много для одной записи. Проверьте время в WitnessWork."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igihe kibarwa kingana n'amasaha 24 cyangwa kirenga, ibyo bikaba birebire cyane ku nyandiko imwe. Reba igihe muri WitnessWork."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kipima muda kina saa 24 au zaidi, ambayo ni muda mrefu mno kwa ingizo moja. Angalia muda katika WitnessWork."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймер показує 24 години або більше, що забагато для одного запису. Перевірте час у WitnessWork."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ đếm giờ đã chạy từ 24 giờ trở lên, quá dài cho một mục. Hãy kiểm tra thời gian trong WitnessWork."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计时器已达 24 小时或更长，对于一条记录来说太长了。请在 WitnessWork 中检查时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計時器已達 24 小時或以上，對單筆紀錄來說太長。請在 WitnessWork 中檢查時間。"
          }
        }
      }
    },
