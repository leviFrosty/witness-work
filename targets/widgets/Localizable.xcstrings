    "pet.widgetDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفيقك وغرفته، مع قلوبه."
          }
        },
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pet yenu ne ng'anda yayo, na mutima yayo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Begleiter und sein Zimmer, mit seinen Herzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your companion and its room, with its hearts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mascota y su habitación, con sus corazones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compagnon et sa chambre, avec ses cœurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo compagno e la sua stanza, con i suoi cuori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペットとその部屋、そしてハート。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반려동물과 방, 그리고 하트 수."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je maatje en zijn kamer, met zijn hartjes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu companheiro e o quarto dele, com os corações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu companheiro e o respetivo quarto, com os seus corações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш питомец и его комната, с сердечками."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inshuti yawe n'icyumba cyayo, hamwe n'imitima yayo."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rafiki yako na chumba chake, pamoja na mioyo yake."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш улюбленець і його кімната, з його сердечками."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thú cưng của bạn và căn phòng của nó, cùng số trái tim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的伙伴和它的小屋，还有它的爱心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的寵物和牠的房間，還有牠的愛心。"
          }
        }
      }
    },
