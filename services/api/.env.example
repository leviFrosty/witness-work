# Local credentials for `pnpm run admin:reset-usage`.
# Copy to .env (gitignored). These values must match the separate Wrangler
# ADMIN_API_TOKEN secrets configured for each deployed environment.
ADMIN_API_TOKEN=your_production_admin_token
ADMIN_API_TOKEN_BETA=your_different_beta_admin_token

# Optional; --beta defaults to https://api-beta.witnesswork.app and production to
# https://api.witnesswork.app. The old production host serves the same Worker
# for good. There is no flag for development: it runs only locally, with the
# token in .dev.vars (or the verify launcher's own).
# WW_API_BETA_URL=https://api-beta.witnesswork.app
# WW_API_PROD_URL=https://ww-proxy.leviwilkerson.com
