{
  "name": "witness-work",
  "version": "1.46.0",
  "main": "src/index.js",
  "scripts": {
    "dev:ios": "node scripts/with-local-env.mjs development ios -- expo start --ios",
    "dev:android": "node scripts/with-local-env.mjs development android -- expo start --android",
    "dev:prod": "node scripts/with-local-env.mjs production ios -- expo start --no-dev --minify",
    "web": "node scripts/web.mjs start",
    "web:build": "node scripts/web.mjs build",
    "web:test": "playwright test --config e2e/web/playwright.config.ts",
    "ios": "node scripts/with-local-env.mjs development ios -- expo run:ios",
    "android": "node scripts/with-local-env.mjs development android -- expo run:android",
    "ios:ota": "node scripts/with-local-env.mjs development ios -- expo run:ios --configuration Release --no-bundler",
    "android:ota": "node scripts/with-local-env.mjs development android -- expo run:android --variant release --no-bundler",
    "prebuild:android": "node scripts/with-local-env.mjs development android -- expo prebuild --platform android",
    "clean": "rm -rf node_modules .tamagui .expo .cache *.tar.gz ios",
    "prebuild": "pnpm sync:widget-shared && expo prebuild --platform ios --clean",
    "sync:widget-shared": "node ./scripts/sync-widget-shared.mjs",
    "check:watch-parity": "node ./scripts/check-watch-parity.mjs",
    "check:unused-locales": "node scripts/check-unused-locale-keys.mjs",
    "sync:help": "node scripts/sync-help-center.mjs",
    "build": "pnpm sync:widget-shared && node scripts/with-local-env.mjs development ios -- eas build -p ios --profile development-simulator --local",
    "build:production": "pnpm sync:widget-shared && node scripts/with-local-env.mjs production ios -- eas build -p ios --profile production-simulator --local",
    "build:prod-auto-submit": "./scripts/build-prod-auto-submit.sh",
    "build:beta": "./scripts/build-beta.sh",
    "eas-build-post-install": "npm install --global @posthog/cli@0.18.1",
    "upload:posthog-sourcemaps": "posthog-cli --dotenv-file .env.production hermes upload --directory dist",
    "check:locales": "node scripts/check-is-missing-locale-keys.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "bump-version": "node ./scripts/bump-version.js",
    "prepare": "husky",
    "test": "vitest",
    "test:release-tools": "node --test scripts/tests/release-tools.node.mjs scripts/tests/sync-help-center.node.mjs scripts/tests/web-host.node.mjs",
    "test:calendar-native": "node --test scripts/tests/calendar-native.node.mjs",
    "test:buddies-alerts-native": "node --test scripts/tests/buddies-alerts.node.mjs",
    "test:watch-native": "node --test scripts/tests/watch-*.node.mjs",
    "test:speech-android": "node --test scripts/tests/speech-android.node.mjs",
    "testFinal": "vitest run",
    "check:all": "concurrently 'pnpm run test:release-tools' 'pnpm run test:web-env' 'pnpm run testFinal' 'pnpm run typecheck' 'pnpm run lint' 'pnpm run doctor'",
    "testVitest": "",
    "fmt": "prettier --write . --log-level warn --cache",
    "typecheck": "node_modules/typescript-go/bin/tsc -p ./tsconfig.json && node_modules/typescript-go/bin/tsc -p ./web/host/tsconfig.json",
    "lint": "eslint . --cache --cache-location .cache/.eslintcache",
    "doctor": "node scripts/with-local-env.mjs development ios -- expo-doctor",
    "deps": "madge --ts-config ./tsconfig.json src/app/App.tsx -c",
    "build:android": "node scripts/with-local-env.mjs development android -- eas build -p android --profile development --local",
    "build:android:production": "node scripts/with-local-env.mjs production android -- eas build -p android --profile production --local",
    "build:wear": "node scripts/with-local-env.mjs development android -- eas build -p android --profile development-wear --local",
    "build:wear:production": "node scripts/with-local-env.mjs production android -- eas build -p android --profile production-wear --local",
    "check:env:android": "node scripts/with-local-env.mjs development android --check",
    "check:env:ios": "node scripts/with-local-env.mjs development ios --check",
    "test:local-env": "node --test scripts/tests/local-env.node.mjs",
    "test:web-env": "node --test scripts/tests/web-env.node.mjs",
    "test:verify": "node --test scripts/tests/verify-locks.node.mjs scripts/tests/verify-ax.node.mjs",
    "test:perf": "node --test scripts/tests/perf.node.mjs",
    "update:dev": "node scripts/ota.mjs development",
    "update:beta": "node scripts/ota.mjs beta",
    "update:production": "node scripts/ota.mjs production",
    "test:ota": "node --test scripts/tests/ota.node.mjs",
    "web:serve": "node scripts/web-host.mjs serve",
    "web:deploy:dev": "node scripts/web-host.mjs deploy dev",
    "web:deploy:beta": "node scripts/web-host.mjs deploy beta",
    "web:deploy:production": "node scripts/web-host.mjs deploy production"
  },
