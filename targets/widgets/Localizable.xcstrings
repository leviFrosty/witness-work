        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch #__# Tính năng Lịch hiện có sẵn cho những người tiên phong và các nhà xuất bản theo dõi mục tiêu khác. #__# Bộ nhớ đệm thời gian #__# Ngày mai #__# Cuộc hẹn #__# Không có cuộc hẹn sắp tới #__# Chưa có danh bạ #__# Tin nhắn #__# Hướng dẫn #__# Tháng này\n#__# Widget #__# Cấu hình giao diện và cách hoạt động của widget trên màn hình chính. #__# Widget Danh bạ #__# Widget Cuộc hẹn #__# Thứ tự sắp xếp #__# Khoảng thời gian #__# Liên lạc lâu nhất #__# Không có #__# 7 ngày tới #__# 14 ngày tới #__# 30 ngày tới\n#__# Được báo cáo hôm nay #__# Cuộc trò chuyện trong tháng này #__# Nghiên cứu trong tháng này #__# Quá hạn #__# Cuộc trò chuyện bị bỏ lỡ #__# Lên lịch lại #__# Đánh dấu hoàn thành #__# hoặc #__# Chuyển cuộc theo dõi này sang một ngày mới. #__# Cuộc trò chuyện mới #__# Ghi lại một cuộc thăm viếng mới với liên hệ này."
          }
