
# Lottie minified assets
src/assets/lottie/**
# Help Center snapshots, minified by `pnpm sync:help`.
src/assets/help-center/**

# TODO: make this only exluded when using husky and prettier cli
src/locales/**

# Symlinks to shared Stopwatch Swift sources (canonical files live in
# modules/stopwatch-bridge/ios/). Prettier errors on explicitly-staged symlinks.
targets/widgets/Stopwatch/*.swift
# Firebase config, byte for byte as Firebase writes it: it is a native
# fingerprint input, so reformatting it forces a native rebuild.
google-services.json
# pnpm owns the lockfile's format, and it writes keys longer than YAML's
# 1024-character limit (expo's snapshot key), which Prettier can't parse.
pnpm-lock.yaml

# Upgrade fixtures: the exact bytes each release wrote (docs/upgrade-fixtures.md).
src/__tests__/__data__/releases/**/*.json

# services/ (its own workspace). Help Center answers and their test fixtures
# are content: authors and the translation step own their bytes. TanStack
# Router writes routeTree.gen.ts on every build.
services/marketing/content/**
services/marketing/tests/unit/fixtures/**
services/marketing/src/routeTree.gen.ts
