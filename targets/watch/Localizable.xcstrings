    "watchComplicationDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمتك هذا الشهر بنظرة سريعة."
          }
        },
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umulimo wa mweshi uno mu kumona kumo."
