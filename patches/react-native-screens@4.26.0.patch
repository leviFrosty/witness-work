+#pragma mark - Prevented tab taps
+
+// UIKit shows a tapped tab as selected before it asks the delegate: the tab bar slides its selection toward the tab
+// and back, and the iPad sidebar keeps the tab highlighted. So taps on tabs with `preventNativeSelection` are taken
+// before they reach either.
+
+- (void)installPreventedTabTapRecognizerIfNeeded
+{
+  if (_preventedTabTapRecognizer != nil) {
+    return;
+  }
+  _preventedTabTapRecognizer = [[UITapGestureRecognizer alloc] initWithTarget:self
+                                                                       action:@selector(handlePreventedTabTap:)];
+  _preventedTabTapRecognizer.delegate = self;
+  [self.view addGestureRecognizer:_preventedTabTapRecognizer];
+}
+
+- (void)handlePreventedTabTap:(UITapGestureRecognizer *)recognizer
+{
+  UIViewController *viewController = [self preventedTabViewControllerAt:[recognizer locationInView:self.view]];
+  if (viewController != nil) {
+    [self onDidPreventUserFromSelectingViewControllerWithKey:[self screenKeyForViewController:viewController]];
+  }
+}
+
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer shouldReceiveTouch:(UITouch *)touch
+{
+  if (gestureRecognizer != _preventedTabTapRecognizer) {
+    return YES;
+  }
+  for (UIViewController *viewController in self.viewControllers) {
+    if (viewController.isViewLoaded && [touch.view isDescendantOfView:viewController.view]) {
+      // A touch in a tab's content.
+      return NO;
+    }
+  }
+  return [self preventedTabViewControllerAt:[touch locationInView:self.view]] != nil;
+}
+
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer
+    shouldBeRequiredToFailByGestureRecognizer:(UIGestureRecognizer *)otherGestureRecognizer
+{
+  // The tab bar and the sidebar select only once the tap has failed.
+  return gestureRecognizer == _preventedTabTapRecognizer && [otherGestureRecognizer.view isDescendantOfView:self.view];
+}
+
+/// The tab with `preventNativeSelection` whose tab bar button or sidebar row is at `location`. UIKit doesn't expose
+/// those views, so they're found by the accessibility label they read out.
+- (nullable UIViewController *)preventedTabViewControllerAt:(CGPoint)location
+{
+  NSMutableDictionary<NSString *, UIViewController *> *preventedByLabel = [NSMutableDictionary new];
+  NSMutableSet<UIView *> *contentViews = [NSMutableSet new];
+  for (UIViewController *viewController in self.viewControllers) {
+    if (viewController.isViewLoaded) {
+      [contentViews addObject:viewController.view];
+    }
+    if (![self shouldPreventNativeTabSelection:viewController]) {
+      continue;
+    }
+    UITabBarItem *item = viewController.tabBarItem;
+    NSString *label = item.accessibilityLabel.length > 0 ? item.accessibilityLabel : item.title;
+    if (label.length > 0) {
+      preventedByLabel[label] = viewController;
+    }
+  }
+  if (preventedByLabel.count == 0) {
+    return nil;
+  }
+
+  NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:self.view];
+  while (queue.count > 0) {
+    UIView *view = queue.firstObject;
+    [queue removeObjectAtIndex:0];
+    if (view.hidden || view.alpha <= 0 || [contentViews containsObject:view]) {
+      continue;
+    }
+    UIViewController *viewController = view.accessibilityLabel != nil ? preventedByLabel[view.accessibilityLabel] : nil;
+    if (viewController != nil && CGRectContainsPoint([view convertRect:view.bounds toView:self.view], location)) {
+      return viewController;
+    }
+    [queue addObjectsFromArray:view.subviews];
+  }
+  return nil;
+}
+
+/// A selection that doesn't come from a tap (VoiceOver, a keyboard) still reaches the delegate, and the iPad sidebar
+/// keeps the refused tab highlighted until the tabs are set again.
+- (void)restoreSidebarSelectionIfNeeded
+{
+#if !TARGET_OS_TV
+  if (@available(iOS 18.0, *)) {
+    if (self.mode == UITabBarControllerModeTabBar || self.sidebar.isHidden ||
+        self.traitCollection.horizontalSizeClass != UIUserInterfaceSizeClassRegular) {
+      return;
+    }
+    __weak RNSTabBarController *weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      RNSTabBarController *strongSelf = weakSelf;
+      if (strongSelf == nil) {
+        return;
+      }
+      UIViewController *selectedViewController = strongSelf.selectedViewController;
+      strongSelf->_isHandlingExplicitSelectionUpdate = YES;
+      [strongSelf setViewControllers:strongSelf.viewControllers animated:NO];
+      [strongSelf setSelectedViewController:selectedViewController];
+      strongSelf->_isHandlingExplicitSelectionUpdate = NO;
+    });
+  }
+#endif
+}
+
