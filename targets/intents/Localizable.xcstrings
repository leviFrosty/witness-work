    "siriTimerEmpty" : {
      "extractionState" : "manual",
      "localizations" : {
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icakupimako cikwata panono ukucila iminiti imo, ico tapali inshita yalundwako."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Timer hat weniger als eine Minute, daher wurde keine Zeit hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timer has less than a minute, so no time was added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cronómetro tiene menos de un minuto, así que no se agregó tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minuteur affiche moins d’une minute, aucun temps n’a donc été ajouté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer ha meno di un minuto, quindi non è stato aggiunto alcun tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーが1分未満のため、時間は追加されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 1분 미만이어서 시간이 추가되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De timer staat op minder dan een minuut, dus er is geen tijd toegevoegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cronômetro tem menos de um minuto, então nenhum tempo foi adicionado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O temporizador tem menos de um minuto, por isso não foi adicionado tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В таймере меньше минуты, поэтому время не добавлено."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igihe kibarwa kiri munsi y'umunota umwe, bityo nta gihe cyongeweho."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kipima muda kina chini ya dakika moja, kwa hivyo hakuna muda ulioongezwa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймер показує менше хвилини, тому час не додано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ đếm giờ chưa đến một phút, nên không có giờ nào được thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计时器不足一分钟，因此没有添加时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計時器不到一分鐘，所以沒有新增時間。"
          }
        }
      }
    },
