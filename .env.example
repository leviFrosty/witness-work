# Local commands explicitly select an environment (all real files gitignored):
#   .env / .env.local — development base and optional override
#   .env.production / .env.production.local — production base and override
#   .env.beta — internal Beta values for scripts/build-beta.sh
# Copy this file to the appropriate base file and fill in its values.
# App config is exported to local EAS jobs; Expo dotenv reloading is disabled.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
# Android uses the Google Play app's public SDK key from the same RevenueCat project.
# For development, both platforms can use the same RevenueCat Test Store key.
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
# Build-time Maps SDK for Android key. Local Android commands require a real key.
# Restrict the real key to the Android package and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
APP_VARIANT=development # development | production
EXPO_PUBLIC_SILENT=false
# PostHog — public client configuration embedded into the Expo app config.
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://your-posthog-host
# Build-only source map and native symbol credentials. Never expose these via Expo extra/public vars.
# Personal API key: error tracking write + organization read scopes.
# Also configure these in EAS for cloud preview/release builds.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://us.posthog.com
# ww-api — optional. Point at a dev/staging worker so the App Attest dev-bypass
# never touches production, and set the bypass token (must match the dev
# worker's NOTES_IMPORT_DEV_BYPASS_TOKEN) so the simulator can attest.
# Android dev commands forward a localhost port with adb reverse; boot the device first.
# Start ww-api separately with HERE_API_KEY in its Wrangler secrets for autocomplete.
# In .env.production, leave BOTH blank so the app uses the production API.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_DEV_BYPASS=
