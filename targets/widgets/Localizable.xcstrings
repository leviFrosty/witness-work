    "widgetAppointmentsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتابعات القادمة. يفتح النقر على أي متابعة متأخرة نافذة لإعادة جدولتها."
          }
        },
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukukonkapo kwapantanshi. Ifyafiba filanga icipao ca kucinja inshita nga mwatinika."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anstehende Folgebesuche. Beim Antippen überfälliger Einträge öffnet sich ein Blatt zum Verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming follow-ups. Overdue items surface a reschedule sheet on tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximos seguimientos. Al tocar un elemento atrasado se abre la hoja para reprogramarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prochains suivis. Les éléments en retard ouvrent une feuille de report au toucher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossimi follow-up. Toccando un elemento in ritardo si apre la schermata per riprogrammarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後のフォローアップです。期限切れの項目をタップすると、日程変更シートが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다가오는 다음 방문입니다. 기한이 지난 항목을 탭하면 일정 변경 화면이 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aankomende vervolgbezoeken. Bij achterstallige items verschijnt na een tik een blad om opnieuw in te plannen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximos acompanhamentos. Ao tocar em itens atrasados, abre-se uma tela para reagendar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximos acompanhamentos. Os itens em atraso abrem uma folha de reagendamento ao tocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предстоящие повторные посещения. При нажатии на просроченные открывается окно переноса."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusubirayo kuza. Ibyarenze igihe bigaragaza urupapuro rwo kubihindurira igihe iyo ukandaho."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufuatiliaji unaokuja. Vipengee vilivyochelewa hufungua karatasi ya kupanga upya ukigusa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Майбутні повторні зустрічі. Торкніться простроченого, щоб перенести його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lần thăm lại sắp tới. Chạm vào mục quá hạn để mở bảng đổi lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将到来的跟进。轻点已逾期的项目，会弹出重新安排的面板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即將到來的後續探訪。點按逾期項目會顯示重新安排的面板。"
          }
        }
      }
    },
    "widgetCalendarDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
