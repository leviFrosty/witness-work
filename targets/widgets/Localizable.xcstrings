    "widgetContactsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصول سريع إلى جهات الاتصال. اضبط الترتيب والإجراء والمفضلة من الإعدادات."
          }
        },
        "bem" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukufika bwangu ku bakulanshanya benu. Ukusala, ico mulecita, ne fyatemwikwa fisalwa mu Ifyo Mwasala."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneller Zugriff auf Ihre Kontakte. Sortierung, Aktion und Favoriten stellen Sie in den Einstellungen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick access to your contacts. Sort, action, and favorites set in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso rápido a tus contactos. El orden, la acción y los favoritos se definen en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès rapide à vos contacts. Tri, action et favoris se règlent dans les paramètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso rapido ai tuoi contatti. Ordinamento, azione e preferiti si impostano in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先にすばやくアクセスできます。並べ替え、操作、お気に入りは設定で選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처에 빠르게 접근합니다. 정렬, 동작, 즐겨찾기는 설정에서 지정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snelle toegang tot je contacten. Sortering, actie en favorieten stel je in bij Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso rápido aos seus contatos. Ordem, ação e favoritos definidos em Configurações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso rápido aos seus contactos. Ordenação, ação e favoritos definidos nas Definições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрый доступ к вашим контактам. Сортировка, действие и избранное задаются в настройках."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugera vuba ku bantu bawe. Gutondeka, igikorwa n'abakunzwe bishyirwaho muri Igenamiterere."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufikiaji wa haraka wa anwani zako. Mpangilio wa kupanga, kitendo, na vipendwa huwekwa katika Mipangilio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкий доступ до ваших контактів. Сортування, дія й обрані задаються в налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truy cập nhanh vào các liên hệ của bạn. Sắp xếp, thao tác và mục yêu thích được đặt trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速访问你的联系人。排序、操作和收藏可在设置中调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速存取你的聯絡人。排序、動作和最愛可在「設定」中設定。"
          }
        }
      }
