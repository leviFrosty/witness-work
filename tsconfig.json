{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "customConditions": ["react-native-legacy-deep-imports"]
  },
  // expo/tsconfig.base.json's list (an `exclude` here replaces it), plus
  // services/, which has its own workspace and tsconfigs, and the web host
  // Worker, the maps and Turnstile frames and the service worker, which have
  // their own runtime types (web/host, web/maps-frame, web/verify-frame and
  // web/sw's tsconfig.json).
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "services",
    "web/host",
    "web/maps-frame",
    "web/sw",
    "web/verify-frame"
  ]
}
