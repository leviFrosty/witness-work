{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "customConditions": ["react-native-legacy-deep-imports"]
  },
  // expo/tsconfig.base.json's list (an `exclude` here replaces it), plus
  // services/, which has its own workspace and tsconfigs.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "services"
  ]
}
