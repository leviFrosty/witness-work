// The Turnstile frame's Worker (docs/web-turnstile.md): static files only, with
// the headers `scripts/web-verify.mjs` writes into `dist/_headers`. Deploy only
// through `pnpm web:deploy:verify:<dev|production>`, never `wrangler deploy` by
// hand. The top level is for `pnpm web:serve:verify`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ww-verify-local",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "ww-verify-dev",
      "routes": [
        { "pattern": "verify-dev.witnesswork.app", "custom_domain": true },
      ],
      "workers_dev": false,
      "preview_urls": false,
    },
    "production": {
      "name": "ww-verify",
      "routes": [
        { "pattern": "verify.witnesswork.app", "custom_domain": true },
      ],
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
